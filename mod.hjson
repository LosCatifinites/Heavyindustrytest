# 游戏内显示的模组名
displayName: "Heavy industry"

# ★★ 内部名必须保持 "重工业" ★★
# Mindustry 会把内容名和 bundle key 自动加上「模组名-」前缀
# （见官方 ContentParser.java: `<mod> + "-" + name`）。
# 若改成别的名字，现有 113 个 content/*.json、bundles、贴图名（重工业-xxx）、
# 存档与科技树引用全部会失配。改名前请务必确认。
name: "重工业"

author: "樱洛清"

# Java 模组入口类（全限定名）
main: "hiy.HeavyIndustry"

description: "专注于扩展以及更多的内容\n模组版本2.1 Java 版"

version: "2.1"

# Java 模组要求 >= 154（见官方 Mods.java: meta.getMinMajor() >= minJavaModGameVersion）
# 目标版本 = 本机实测的游戏版本 Mindustry v8 Build 160.5
#（MindustryX 客户端版本串 8-official-2026.09.20.B498，与上游 v160.5 发布日 2026-09-20 一致）
minGameVersion: 160.5

# 声明这是 Java 模组
java: true
